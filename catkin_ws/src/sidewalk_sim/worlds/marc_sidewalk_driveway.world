    <!-- ==== CURB FACE ====
         0.15 m tall, split either side of the driveway, since real curb-cut
         driveways drop to zero height across the crossing.
         Source had a flat grey material; textured here so it yields features. -->
    <model name="curb_west">
      <static>true</static>
      <link name="link">
        <collision name="collision"><pose>4.875 3.05 0.075 0 0 0</pose>
          <geometry><box><size>9.75 0.1 0.15</size></box></geometry></collision>
        <visual name="cw1"><pose>1.22 3.05 0.075 0 0 0</pose><geometry><box><size>2.44 0.1 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
        <visual name="cw2"><pose>3.66 3.05 0.075 0 0 0</pose><geometry><box><size>2.44 0.1 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
        <visual name="cw3"><pose>6.09 3.05 0.075 0 0 0</pose><geometry><box><size>2.44 0.1 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
        <visual name="cw4"><pose>8.53 3.05 0.075 0 0 0</pose><geometry><box><size>2.44 0.1 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
      </link>
    </model>

    <model name="curb_east">
      <static>true</static>
      <link name="link">
        <collision name="collision"><pose>21.125 3.05 0.075 0 0 0</pose>
          <geometry><box><size>9.75 0.1 0.15</size></box></geometry></collision>
        <visual name="ce1"><pose>17.47 3.05 0.075 0 0 0</pose><geometry><box><size>2.44 0.1 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
        <visual name="ce2"><pose>19.91 3.05 0.075 0 0 0</pose><geometry><box><size>2.44 0.1 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
