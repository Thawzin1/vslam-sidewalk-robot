      </link>
    </model>

    <!-- ==== DRIVEWAY APRON ====
         Flush crossing, no curb face, 6.5 m wide (UNVERIFIED PLACEHOLDER).
         Given its own distinct material so the crossing is visually
         identifiable == which is exactly what loop closure keys on, and
         what makes this the landmark of the route. -->
    <model name="driveway_apron">
      <static>true</static>
      <link name="link">
        <collision name="collision"><pose>13 2.55 0.005 0 0 0</pose>
          <geometry><box><size>6.5 1.1 0.01</size></box></geometry></collision>
        <visual name="da1"><pose>10.83 2.55 0.006 0 0 0</pose><geometry><box><size>2.17 1.1 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material></visual>
        <visual name="da2"><pose>13 2.55 0.006 0 0 0</pose><geometry><box><size>2.17 1.1 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material></visual>
        <visual name="da3"><pose>15.17 2.55 0.006 0 0 0</pose><geometry><box><size>2.17 1.1 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material></visual>
      </link>
    </model>

    <!-- ==== ROADWAY ==== context slab beyond the curb, tiled and alternating -->
    <model name="roadway">
      <static>true</static>
      <link name="link">
        <collision name="collision"><pose>13 6.55 0.01 0 0 0</pose>
          <geometry><box><size>26 6.9 0.02</size></box></geometry></collision>
        <visual name="r01"><pose>1 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
        <visual name="r02"><pose>3 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual>
        <visual name="r03"><pose>5 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
        <visual name="r04"><pose>7 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual>
        <visual name="r05"><pose>9 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
        <visual name="r06"><pose>11 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual>
        <visual name="r07"><pose>13 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
        <visual name="r08"><pose>15 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual>
        <visual name="r09"><pose>17 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
        <visual name="r10"><pose>19 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual>
        <visual name="r11"><pose>21 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
        <visual name="r12"><pose>23 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual>
        <visual name="r13"><pose>25 6.55 0.011 0 0 0</pose><geometry><box><size>2 6.9 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Road</name></script></material></visual>
      </link>
    </model>

    <!-- ==== BUILDING FACADE ====
         Five segments, five DIFFERENT textures. Distinct surfaces are what
         stop loop closure welding two stretches of an otherwise uniform
         corridor together. -->
    <model name="building_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision"><pose>13 -0.15 2.0 0 0 0</pose>
          <geometry><box><size>26 0.3 4.0</size></box></geometry></collision>
        <visual name="f1"><pose>2.6 -0.15 2.0 0 0 0</pose><geometry><box><size>5.2 0.3 4.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <visual name="f2"><pose>7.8 -0.15 2.0 0 0 0</pose><geometry><box><size>5.2 0.3 4.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PaintedWall</name></script></material></visual>
        <visual name="f3"><pose>13 -0.15 2.0 0 0 0</pose><geometry><box><size>5.2 0.3 4.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/BuildingFrame</name></script></material></visual>
        <visual name="f4"><pose>18.2 -0.15 2.0 0 0 0</pose><geometry><box><size>5.2 0.3 4.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material></visual>
        <visual name="f5"><pose>23.4 -0.15 2.0 0 0 0</pose><geometry><box><size>5.2 0.3 4.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- ==== STREET FURNITURE ====
         All in the buffer zone (y ~2.4-2.8) or hard against the building
         (y ~0.35), so nothing intrudes on the 2.0 m walkway == the Husky is
         0.685 m over the tyres and drives the centreline at y=1.0, spanning
         y 0.66-1.34. Spacing is deliberately IRREGULAR: evenly spaced
         identical objects form the repeating pattern that causes ambiguous
         feature matching. -->

    <model name="pole_w"><static>true</static><pose>3.4 2.72 1.22 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Trunk</name></script></material></visual></link></model>

    <model name="bench_w"><static>true</static><pose>5.2 0.36 0.245 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.6 0.45 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.45 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>

    <model name="hydrant"><static>true</static><pose>7.1 2.62 0.345 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.14</radius><length>0.65</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.14</radius><length>0.65</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Steps</name></script></material></visual></link></model>

    <!-- signs flanking the driveway cut == the strongest place-signature on
         the route, and the thing a returning pass should recognise -->
    <model name="sign_dw_west"><static>true</static><pose>9.5 2.75 1.02 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.08 0.5 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 0.5 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Runway</name></script></material></visual></link></model>

    <model name="sign_dw_east"><static>true</static><pose>16.5 2.75 1.02 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.08 0.5 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 0.5 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Primary</name></script></material></visual></link></model>

    <model name="bin_e"><static>true</static><pose>19.6 2.6 0.37 0 0 0.4</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.24</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.24</radius><length>0.7</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Motorway</name></script></material></visual></link></model>

    <model name="planter_e"><static>true</static><pose>21.8 0.38 0.29 0 0 0.15</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.7 0.5 0.55</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.5 0.55</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual></link></model>

    <model name="pole_e"><static>true</static><pose>24.3 2.7 1.22 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual></link></model>

    <!-- parked car on the roadway: large, distinctive, and only visible from
         part of the route, which makes it a useful place signature -->
    <model name="parked_car"><static>true</static><pose>18.5 5.2 0.75 0 0 0.015</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.4 1.8 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.4 1.8 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PioneerBody</name></script></material></visual></link></model>

    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.75 0.8 1</background><shadows>false</shadows></scene>

    <!-- ==== INITIAL VIEWER CAMERA ====
         Set here rather than pushed at runtime over
         /gazebo/<world>/user_camera/pose, which proved unreliable: it left the
         viewport black more often than not, and its hung `gz topic` processes
         accumulated. Declared in the world, gzclient simply opens looking at
         the right thing.

         Pose is x y z roll pitch yaw. This one stands off the west end of the
         route, above the roadway, angled down and along +X so the walkway, the
         buffer, the kerb line and the driveway cut at X=13 are all in frame. -->
    <gui>
      <camera name="user_camera">
        <pose>-1 -9 7 0 0.374 0.666</pose>
      </camera>
    </gui>

  </world>
</sdf>
