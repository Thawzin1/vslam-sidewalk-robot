    <model name="buffer_zone_east">
      <static>true</static>
      <link name="link">
        <collision name="collision"><pose>21.125 2.5 0.01 0 0 0</pose>
          <geometry><box><size>9.75 1.0 0.02</size></box></geometry></collision>
        <visual name="be1"><pose>17.47 2.5 0.011 0 0 0</pose><geometry><box><size>2.44 1.0 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script></material></visual>
        <visual name="be2"><pose>19.91 2.5 0.011 0 0 0</pose><geometry><box><size>2.44 1.0 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script></material></visual>
        <visual name="be3"><pose>22.34 2.5 0.011 0 0 0</pose><geometry><box><size>2.44 1.0 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script></material></visual>
        <visual name="be4"><pose>24.78 2.5 0.011 0 0 0</pose><geometry><box><size>2.44 1.0 0.02</size></box></geometry>
