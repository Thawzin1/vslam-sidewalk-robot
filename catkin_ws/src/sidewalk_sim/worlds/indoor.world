<?xml version="1.0"?>
<!--
  indoor.world — a small, fully OFFLINE indoor room for the Husky VSLAM sim.

  Everything here uses shapes + Gazebo's built-in materials (shipped with
  gazebo11, no fuel.gazebosim.org downloads), so it loads with no internet.
  Brick-textured walls + varied obstacles give RTAB-Map visual texture to build
  a recognisable 3-D map and close loops. ~12 x 10 m room, 2.5 m walls.
-->
<sdf version="1.6">
  <world name="indoor">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ---- room walls (one static model, brick-textured) ---- -->
    <model name="room">
      <static>true</static>
      <link name="walls">
        <!-- north (+Y) -->
        <collision name="n_c"><pose>0 5 1.25 0 0 0</pose><geometry><box><size>12 0.2 2.5</size></box></geometry></collision>
        <visual   name="n_v"><pose>0 5 1.25 0 0 0</pose><geometry><box><size>12 0.2 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <!-- south (-Y) -->
        <collision name="s_c"><pose>0 -5 1.25 0 0 0</pose><geometry><box><size>12 0.2 2.5</size></box></geometry></collision>
        <visual   name="s_v"><pose>0 -5 1.25 0 0 0</pose><geometry><box><size>12 0.2 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <!-- east (+X) -->
        <collision name="e_c"><pose>6 0 1.25 0 0 0</pose><geometry><box><size>0.2 10 2.5</size></box></geometry></collision>
        <visual   name="e_v"><pose>6 0 1.25 0 0 0</pose><geometry><box><size>0.2 10 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <!-- west (-X) -->
        <collision name="w_c"><pose>-6 0 1.25 0 0 0</pose><geometry><box><size>0.2 10 2.5</size></box></geometry></collision>
        <visual   name="w_v"><pose>-6 0 1.25 0 0 0</pose><geometry><box><size>0.2 10 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
      </link>
    </model>

    <!-- ---- obstacles / landmarks (varied shapes + colours for features) ---- -->
    <model name="crate_wood"><static>true</static><pose>2.5 2.0 0.4 0 0 0.3</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>

    <model name="pillar_a"><static>true</static><pose>-3.0 1.5 0.75 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual></link></model>

    <model name="pillar_b"><static>true</static><pose>-2.5 -2.5 0.75 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual></link></model>

    <model name="box_tall"><static>true</static><pose>3.5 -2.0 0.6 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.6 1.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.2 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link></model>

    <model name="crate_wood2"><static>true</static><pose>0.5 -3.2 0.3 0 0 0.8</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>

    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate><max_step_size>0.001</max_step_size></physics>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.7 1</background><shadows>false</shadows></scene>
  </world>
</sdf>
