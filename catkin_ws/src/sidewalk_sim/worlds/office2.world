    <!-- ==== building shell + interior walls (one static model) ====
         Every one of the 37 wall segments below is a different, TEXTURED
         Gazebo material (cycled from a 20-material pool; repeats are >=17
         segments apart in the cycle, so no two touching/facing walls share
         a material): see header. -->
    <model name="building">
      <static>true</static>
      <link name="walls">

        <!-- outer shell -->
        <collision name="w001_c"><pose>0 9 1.25 0 0 0</pose><geometry><box><size>24 0.25 2.5</size></box></geometry></collision>
        <visual   name="w001_v"><pose>0 9 1.25 0 0 0</pose><geometry><box><size>24 0.25 2.5</size></box></geometry>
    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <collision name="w002_c"><pose>-7.2 -9 1.25 0 0 0</pose><geometry><box><size>9.6 0.25 2.5</size></box></geometry></collision>
