    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PaintedWall</name></script></material></visual>
        <collision name="w003_c"><pose>5.7 -9 1.25 0 0 0</pose><geometry><box><size>12.6 0.25 2.5</size></box></geometry></collision>
        <visual   name="w003_v"><pose>5.7 -9 1.25 0 0 0</pose><geometry><box><size>12.6 0.25 2.5</size></box></geometry>
    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CeilingTiled</name></script></material></visual>
        <collision name="w004_c"><pose>12 0 1.25 0 0 0</pose><geometry><box><size>0.25 18 2.5</size></box></geometry></collision>
        <visual   name="w004_v"><pose>12 0 1.25 0 0 0</pose><geometry><box><size>0.25 18 2.5</size></box></geometry>
    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Residential</name></script></material></visual>
        <collision name="w005_c"><pose>-12 0 1.25 0 0 0</pose><geometry><box><size>0.25 18 2.5</size></box></geometry></collision>
        <visual   name="w005_v"><pose>-12 0 1.25 0 0 0</pose><geometry><box><size>0.25 18 2.5</size></box></geometry>
    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>

        <!-- V1: west utility column (Pantry/Male/Female Toilet) vs Office1/corridor.
             Doors recentred to each room own midpoint (Pantry/ServerIT 7.25,
             MaleToilet/Storage 4.0, CopyPrint 1.25) so the wider 1.8 m opening
             leaves balanced margins instead of a near-zero sliver at one end. -->
        <collision name="w006_c"><pose>-8.5 8.575 1.25 0 0 0</pose><geometry><box><size>0.12 0.85 2.5</size></box></geometry></collision>
        <visual   name="w006_v"><pose>-8.5 8.575 1.25 0 0 0</pose><geometry><box><size>0.12 0.85 2.5</size></box></geometry>
    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/BuildingFrame</name></script></material></visual>
