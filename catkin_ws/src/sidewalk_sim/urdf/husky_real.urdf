    <origin rpy="0 0 0" xyz="-0.1517 0.08 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="D07"/>
  <joint name="D07_joint" type="fixed">
    <child link="D07"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.1517 0.0 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="E07"/>
  <joint name="E07_joint" type="fixed">
    <child link="E07"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.1517 -0.08 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="F07"/>
  <joint name="F07_joint" type="fixed">
    <child link="F07"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.1517 -0.16 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="G07"/>
  <joint name="G07_joint" type="fixed">
    <child link="G07"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.1517 -0.24 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="A08"/>
  <joint name="A08_joint" type="fixed">
    <child link="A08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 0.24 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="B08"/>
  <joint name="B08_joint" type="fixed">
    <child link="B08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 0.16 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="C08"/>
  <joint name="C08_joint" type="fixed">
    <child link="C08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 0.08 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="D08"/>
  <joint name="D08_joint" type="fixed">
    <child link="D08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 0.0 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="E08"/>
  <joint name="E08_joint" type="fixed">
    <child link="E08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 -0.08 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="F08"/>
  <joint name="F08_joint" type="fixed">
    <child link="F08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 -0.16 0.23385"/>
  </joint>
  <!-- Add Empty Mount -->
  <link name="G08"/>
  <joint name="G08_joint" type="fixed">
    <child link="G08"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="-0.2317 -0.24 0.23385"/>
  </joint>
  <!--
      IMU Link: Standard location to add an IMU (i.e. UM7 or Microstrain)
  -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin rpy="3.1415 0 0" xyz="0 -0.15 0.065"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
      <robotNamespace>/</robotNamespace>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="libhector_gazebo_ros_imu.so" name="base_imu_controller">
      <robotNamespace>/</robotNamespace>
      <updateRate>50.0</updateRate>
      <bodyName>base_link</bodyName>
      <topicName>imu/data</topicName>
      <accelDrift>0.005 0.005 0.005</accelDrift>
      <accelGaussianNoise>0.005 0.005 0.005</accelGaussianNoise>
      <rateDrift>0.005 0.005 0.005 </rateDrift>
      <rateGaussianNoise>0.005 0.005 0.005 </rateGaussianNoise>
      <headingDrift>0.005</headingDrift>
      <headingGaussianNoise>0.005</headingGaussianNoise>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="libhector_gazebo_ros_gps.so" name="gps_controller">
      <robotNamespace>/</robotNamespace>
      <updateRate>40</updateRate>
      <bodyName>base_link</bodyName>
      <frameId>base_link</frameId>
      <topicName>navsat/fix</topicName>
      <velocityTopicName>navsat/vel</velocityTopicName>
      <referenceLatitude>49.9</referenceLatitude>
      <referenceLongitude>8.9</referenceLongitude>
      <referenceHeading>90</referenceHeading>
      <referenceAltitude>0</referenceAltitude>
      <drift>0.0001 0.0001 0.0001</drift>
    </plugin>
  </gazebo>
  <!-- Custom Sensor Arch -->
  <link name="sensor_arch">
    <visual>
      <geometry>
        <mesh filename="package://mcm07_husky/meshes/sensor_arch.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mcm07_husky/meshes/sensor_arch.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="sensor_arch_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_arch"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Swiftnav Antenna -->
  <link name="swiftnav_link">
    <visual>
      <geometry>
        <mesh filename="package://mcm07_husky/meshes/swiftnav_ant.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mcm07_husky/meshes/swiftnav_ant.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="swiftnav_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="swiftnav_link"/>
    <origin rpy="0 0 0" xyz="0.00747 -0.42599 0.57056"/>
  </joint>
  <joint name="os_sensor_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.39"/>
    <parent link="D05"/>
    <child link="os_sensor_base_link"/>
  </joint>
  <link name="os_sensor_base_link"/>
  <joint name="os_sensor_base_to_baseplate" type="fixed">
    <parent link="os_sensor_base_link"/>
    <child link="os_sensor_baseplate"/>
    <origin xyz="0 0 0.008"/>
  </joint>
  <link name="os_sensor_baseplate">
    <visual>
      <geometry>
        <box size="0.112 0.112 0.016"/>
      </geometry>
      <material name="silver">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.112 0.112 0.016"/>
      </geometry>
    </collision>
  </link>
  <joint name="os_sensor_baseplate_to_body" type="fixed">
    <parent link="os_sensor_baseplate"/>
    <child link="os_sensor"/>
    <origin rpy="0 0 0" xyz="0 0 0.042"/>
  </joint>
  <link name="os_sensor">
    <inertial>
      <mass value="0.33"/>
      <origin rpy="0 0 0" xyz="0 0 0.0365"/>
      <inertia ixx="0.000241148" ixy="0" ixz="0" iyy="0.000241148" iyz="0" izz="0.000264"/>
    </inertial>
    <collision name="base_collision">
      <origin rpy="0 0 0" xyz="0 0 0.0365"/>
      <geometry>
        <cylinder length="0.073" radius="0.04"/>
      </geometry>
    </collision>
    <visual name="base_visual">
      <origin rpy="0 0 1.5707" xyz="0 0 0.0"/>
      <geometry>
        <mesh filename="package://ouster_description/meshes/os1_64.dae"/>
        <!-- <cylinder length="0.073" radius="0.04" /> -->
      </geometry>
    </visual>
  </link>
  <link name="os_imu"/>
  <link name="os_lidar"/>
  <joint name="os_sensor_imu_link_joint" type="fixed">
    <parent link="os_sensor"/>
    <child link="os_imu"/>
    <origin rpy="0 0 0" xyz="0.006253 -0.011775 0.007645"/>
  </joint>
  <gazebo reference="os_imu">
    </gazebo>
  <joint name="os_sensor_lidar_link_joint" type="fixed">
    <parent link="os_sensor"/>
    <child link="os_lidar"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.03618"/>
  </joint>
  <!-- Gazebo requires the ouster_gazebo_plugins package -->
  <gazebo reference="os_sensor">
    <sensor name="os_sensor-OS1-64" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>512</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
          <vertical>
            <samples>64</samples>
            <resolution>1</resolution>
            <min_angle>-0.26</min_angle>
            <max_angle>0.26</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.9</min>
          <max>75.0</max>
          <resolution>0.03</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_velodyne_laser.so" name="gazebo_ros_laser_controller">
        <topicName>/ouster/points</topicName>
        <frameName>os_lidar</frameName>
        <min_range>0.9</min_range>
        <max_range>75.0</max_range>
        <gaussianNoise>0.008</gaussianNoise>
      </plugin>
    </sensor>
  </gazebo>
  <!-- IMU -->
  <gazebo>
    <plugin filename="libhector_gazebo_ros_imu.so" name="imu_controller">
      <robotNamespace>/</robotNamespace>
      <updateRate>100.0</updateRate>
      <bodyName>os_imu</bodyName>
      <topicName>/ouster/imu</topicName>
      <accelDrift>0.005 0.005 0.005</accelDrift>
      <accelGaussianNoise>0.005 0.005 0.005</accelGaussianNoise>
      <rateDrift>0.005 0.005 0.005 </rateDrift>
      <rateGaussianNoise>0.005 0.005 0.005 </rateGaussianNoise>
      <headingDrift>0.005</headingDrift>
      <headingGaussianNoise>0.005</headingGaussianNoise>
    </plugin>
  </gazebo>
  <!-- Oak-D Camera Integration -->
  <link name="oak-d-base-frame"/>
  <!-- Joint connecting Oak-D base to stand -->
  <joint name="oak_d_base_joint" type="fixed">
    <parent link="sensor_arch"/>
    <child link="oak-d-base-frame"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.091 0.0 0.590"/>
    <!-- Front edge of stand, centered on 1cm thick plate -->
    <!-- Dimensions: 110x54.5x33 mm  -->
  </joint>
  <!-- ZED X Camera Integration -->
  <link name="zedx_base_frame"/>
  <!-- Joint connecting the ZED X base to the sensor arch -->
  <joint name="zedx_base_joint" type="fixed">
    <parent link="sensor_arch"/>
    <child link="zedx_base_frame"/>
    <origin rpy="0.0 0.0565 0.0" xyz="0.081 -0.040 0.547"/>
    <!-- Own dedicated mount point, not borrowed from oak-d-base-frame.

         WHICH POINT THIS IS: the camera's MOUNT - the outside of the
         housing, where the bracket grips it. It is NOT the left lens. The
         lens is 60 mm to the robot's left, 16 mm up and 10 mm back from
         here, and husky_real_zedx.urdf.xacro builds that offset explicitly.
         Do not copy robot_frames.yaml's camera_front x/y/z into this joint;
         those are the lens.

         sensor_arch is coincident with base_link in this file (identity
         joint), so the numbers below are also the pose relative to
         base_link. That is what makes them directly comparable with the
         real robot's copies.

         DERIVED FROM A TAPE MEASUREMENT, 2026-08-29 - the same measurement
         and the same numbers as the real robot. This is one physical mount
         described twice:
             0.7112   measured, floor -> ZED X housing UPPER SURFACE
           - 0.0159   half the 31.8 mm body height
                      [Stereolabs ZED X datasheet Rev 1.6]
           = 0.6953   camera_center above the floor
           - 0.0160   camera base -> camera_center, from the live tree
           = 0.6793   this frame, above the floor
           - 0.13228  base_link above the floor (base_footprint_joint)
           = 0.5470   <- z
         y = -0.040 is a PHYSICAL re-position of the camera toward
         swiftnav_link, made the same day. It was +0.070; do not "restore"
         it. x = 0.081 is unchanged, from the mount tuned live in sim.

         PITCH 0.0565 rad = 3.24 deg NOSE DOWN is MEASURED, not a design
         choice: a RANSAC floor-plane fit (a statistical fit of a flat plane
         to the depth image's view of the floor, discarding outliers) and
         the ZED's accelerometer reading of gravity, two methods that share
         no failure mode. Roll and yaw are left at 0, but that is
         UNMEASURED-AND-SET-TO-ZERO, not measured-as-zero.

         MUST STAY IDENTICAL to zedx_base_joint in
             sidewalk_bringup/urdf/husky_a200_real.urdf   (real robot, RViz)
         and to cam_pos_x/y/z + cam_pitch in
             sidewalk_perception/launch/zedx_front.launch (the live driver)
         Nothing compares them at runtime. If they drift apart the simulated
         robot and the real one quietly describe different hardware, and
         every sim-vs-real comparison is confounded with no warning.

         SUPERSEDED - the comment that used to sit here described
         "(0.091 0 0.590) shifted by (-0.01 0.07 -0.035)", which lands on
         y = +0.070 and z = 0.555. Both are dead values, and it never
         mentioned the pitch at all. -->
  </joint>
  <!-- This file is a placeholder which is included by default from
       husky.urdf.xacro. If a robot is being customized and requires
       additional URDF, set the HUSKY_URDF_EXTRAS environment variable
       to the full path of the file you would like included. -->
</robot>

