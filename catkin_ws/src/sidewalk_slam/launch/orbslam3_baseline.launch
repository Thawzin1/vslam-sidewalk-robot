<?xml version="1.0"?>
<!--
  orbslam3_baseline.launch — BASELINE 2: ORB-SLAM3, stereo or stereo-inertial.

  ORB-SLAM3 is not a ROS package, so there is no <node pkg="ORB_SLAM3"> tag
  here. It is started through run_orbslam3.py, which checks the three things
  that actually break (missing vocabulary, unbuilt ROS examples, stale settings)
  and gives a specific message for each instead of an inscrutable crash.

  THE SETTINGS FILE MUST BE GENERATED, NOT COPIED
      Run make_orbslam3_config.py first, with the camera running. The exact
      command is in README.md and in EXPLAIN.html; it reads the camera's live
      calibration and writes the settings file this launch expects.

      Copying a settings file from another camera - or from the previous OAK-D
      work - produces a trajectory that is smooth, plausible and wrong by
      whatever ratio the two cameras' focal lengths differ by.

  FAIRNESS NOTE FOR THE COMPARISON
      RTAB-Map is given the IMU (it uses gravity to constrain roll and pitch).
      To compare like with like, ORB-SLAM3 should be run in stereo_inertial
      mode. Running it in plain stereo mode against inertial-aided RTAB-Map
      measures the sensor suite, not the algorithm. Run both if you can, and
      label them separately - the pair also shows how much the IMU is worth.
-->
<launch>

  <arg name="settings" default="$(env HOME)/orbslam3_zedx.yaml"
       doc="Generated by make_orbslam3_config.py. Never hand-written."/>
  <arg name="run_id" default="orbslam3_baseline"/>
  <arg name="mode" default="stereo"
       doc="stereo | stereo_inertial"/>
  <arg name="camera_name" default="zedx_front"/>
  <arg name="node_name"   default="zed_node"/>
  <arg name="orbslam3_root" default="$(env HOME)/Developer/ORB_SLAM3"/>
  <arg name="duration" default="0.0"
       doc="Stop and save after this many seconds. 0 = run until Ctrl-C."/>
  <arg name="equalize" default="false"
       doc="stereo_inertial only: CLAHE contrast equalisation. Worth trying in
            dim indoor corridors where ORB finds too few corners."/>
  <arg name="use_sim_time" default="false"/>
  <arg name="dry_run" default="false"
       doc="Check everything and print the command without launching. Use this
            first, always - it costs two seconds and catches the missing
            vocabulary before you have driven the robot anywhere."/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="sidewalk_slam" type="run_orbslam3.py" name="orbslam3_baseline"
        output="screen" required="false"
        args="--settings $(arg settings)
              --run-id $(arg run_id)
              --mode $(arg mode)
              --camera-name $(arg camera_name)
              --node-name $(arg node_name)
              --orbslam3-root $(arg orbslam3_root)
              --duration $(arg duration)
              $(eval '--equalize' if arg('equalize') in ('true','True','1') else '')
              $(eval '--dry-run'  if arg('dry_run')  in ('true','True','1') else '')"/>

</launch>
