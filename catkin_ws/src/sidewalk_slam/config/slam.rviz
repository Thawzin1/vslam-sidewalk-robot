Panels:
- Class: rviz/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /MapCloud (3D map)1
    Splitter Ratio: 0.5
  Tree Height: 640
- Class: rviz/Views
  Name: Views
Visualization Manager:
  Class: ''
  Name: root
  Global Options:
    Background Color: 22; 22; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz/Grid
    Name: Reference Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 70; 70; 80
    Alpha: 0.35
  - Alpha: 1
    Class: rviz/RobotModel
    Collision Enabled: false
    Enabled: true
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
    Name: RobotModel
    Robot Description: robot_description
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rtabmap_rviz_plugins/MapCloud
    Name: MapCloud (3D map)
    Enabled: true
    Topic: /rtabmap/mapData
    Queue Size: 10
    Cloud decimation: 2
    Cloud max depth: 6
    Cloud min depth: 0.3
    Cloud voxel size: 0.01
    Node filtering radius: 0
    Node filtering angle: 30
    Download map: false
    Download graph: false
    Style: Flat Squares
    Size (m): 0.015
    Size (Pixels): 3
    Alpha: 1
    Color Transformer: RGB8
    Decay Time: 0
  - Class: rviz/Image
    Name: Camera
    Enabled: true
    Image Topic: /zedx_front/zed_node/rgb/image_rect_color
    Transport Hint: raw
    Queue Size: 2
  - Class: rtabmap_rviz_plugins/MapGraph
    Name: Pose graph + loop closures
    Enabled: true
    Topic: /rtabmap/mapGraph
    Global loop closure: 25; 255; 0
    Neighbor: 100; 160; 255
    Local loop closure: 255; 255; 0
    Neighbor merged: 200; 200; 200
  - Class: rviz/Path
    Name: Trajectory
    Enabled: true
    Topic: /rtabmap/mapPath
    Color: 255; 170; 0
    Line Style: Billboards
    Line Width: 0.05
  - Class: rviz/TF
    Name: Camera pose (TF)
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.6
  - Class: rviz/Map
    Name: Occupancy grid (2D)
    Enabled: false
    Topic: /rtabmap/grid_map
    Color Scheme: map
    Draw Behind: true
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.42
      Yaw: 2.35
      Near Clip Distance: 0.05
  Global Options Fixed Frame: map
Window Geometry:
  Height: 1000
  Width: 1720
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Camera:
    collapsed: false
