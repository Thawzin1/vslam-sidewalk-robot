<?xml version="1.0"?>
<!--
  slam_run.launch - the SLAM session launch (used live 27 Sept 2026, s2_slam_01). It lives in
  run/lib/ (Jetson) and is started by path from the staged
  start_drive.sh (SLAM=1), normally through start_slam.sh:
      roslaunch "<this folder>/slam_run.launch" run_id:=... database_path:=~/slam_series2/<run>.db (A COPY)

  WHAT IT IS: the same stack every drive mapped with (record_mapping_run.launch -> rtabmap_mapping.launch ->
  rtabmap_common.launch, localization:=false = MAPPING), pointed at a COPY of drive 10's closed map instead of
  a new file. RTAB-Map then opens the old map and keeps adding to it: a new mapping session (DESIGN.md).
  *Plain terms: the robot is handed drive 10's floor plan and told "keep drawing" - new corridors are added
  to it, and places it recognises pull the old and new parts together.*

  Why a new file and not record_mapping_run.launch: that file cannot (a) change the depth topic (needed for the
  people mask, mask:=true), or (b) pin the three RTAB-Map settings below. Every other argument is the value
  record_mapping_run.launch + start_drive.sh step 3 gave drives 3-10.

  delete_db_on_start is HARD-WIRED false (deleting the database = deleting drive 10's map).
  database_path MUST be the working copy; the staged start_drive.sh (SLAM=1) refuses the master
  (~/slam_series2/localise/s2_static_10_map.db).
-->
<launch>
  <arg name="run_id"/>
  <arg name="database_path"/>
  <arg name="rtabmap_log"          default=""/>
  <arg name="vo_publish_tf"        default="true"/>
  <arg name="extra_rtabmap_params" default=""/>
  <!-- Rtabmap/LoopThr (verified on this build: default 0.11, "Loop closing threshold") = the recognition score a
       picture must reach before RTAB-Map tries to join it to a place it has seen. Drive 10 MAPPED at 0.11
       (its database's Info table). 0.08 is the value the whole-floor localisation ran at on THIS map
       (s2_loc_04: 577 fixes, 0 in the wrong place) and the one registered for this session (PASS_LINES.md).
       In mapping mode it applies only AFTER the new session has joined the old map; before that
       RGBD/AggressiveLoopThr (0.05) applies (Rtabmap.cpp:2146-2157). loop_thr:=0.11 = drive 10's value. -->
  <arg name="loop_thr"             default="0.08"/>
  <!-- mask:=true: RTAB-Map reads the people-masked depth picture (depth_person_mask.py, started by the staged
       start_drive.sh) instead of the camera's own. Needs the camera started with zedx_front_od.yaml. -->
  <arg name="mask"                 default="false"/>
  <arg name="depth_raw"    default="/zedx_front/zed_node/depth/depth_registered"/>
  <arg name="depth_masked" default="/zedx_front/zed_node/depth/depth_registered_masked"/>

  <include file="$(find sidewalk_slam)/launch/rtabmap_common.launch">
    <arg name="localization"         value="false"/>
    <arg name="database_path"        value="$(arg database_path)"/>
    <arg name="delete_db_on_start"   value="false"/>
    <!-- the drives' values (record_mapping_run.launch defaults + start_drive.sh step 3) -->
    <arg name="use_sim_time"         value="false"/>
    <arg name="approx_sync"          value="true"/>
    <arg name="stereo"               value="false"/>
    <arg name="queue_size"           value="5"/>
    <arg name="wait_imu_to_init"     value="true"/>
    <arg name="force_3dof"           value="true"/>
    <arg name="rviz"                 value="false"/>
    <arg name="rtabmap_viz"          value="false"/>
    <arg name="visual_odometry"      value="true"/>
    <arg name="vo_publish_tf"        value="$(arg vo_publish_tf)"/>
    <arg name="extra_rtabmap_params" value="$(arg extra_rtabmap_params)"/>
    <arg name="depth_topic"          value="$(eval arg('depth_masked') if str(arg('mask')).lower() in ('true', '1') else arg('depth_raw'))"/>
  </include>

  <!-- Pinned after the include (last setting wins), each checked by the start script on the parameter server:
       Mem/IncrementalMemory true   = MAPPING (add new places). Written explicitly although rtabmap_common.launch
                                      already yields 'true' for mapping (SOLVED.md: its eval always yields true).
       Mem/InitWMWithAllNodes true  = put every saved node in working memory at start, so every old place can be
                                      recognised. On this map it loads the same 860 nodes as the default
                                      ('last session's nodes'): the other 698 are weight -9 (discarded) either way
                                      (DBDriverSqlite3.cpp:2416-2440, 3607-3625; checked on the master, read-only).
       RGBD/AggressiveLoopThr 0.05  = the default, written so the log proves it (joins the FIRST old place). -->
  <param name="/rtabmap/rtabmap/Mem/IncrementalMemory"   type="string" value="true"/>
  <param name="/rtabmap/rtabmap/Mem/InitWMWithAllNodes"  type="string" value="true"/>
  <param name="/rtabmap/rtabmap/RGBD/AggressiveLoopThr"  type="string" value="0.05"/>
  <param name="/rtabmap/rtabmap/Rtabmap/LoopThr"         type="string" value="$(arg loop_thr)"/>

  <!-- The people mask itself (depth_person_mask.py) is NOT started here: roslaunch can only start programs that
       belong to a ROS package, and this staged folder is not one. The staged start_drive.sh (SLAM=1 MASK=1)
       starts it BEFORE this launch, and it stops itself when this session's rtabmap exits
       (~/.run_records/<run>/rtabmap.pid). -->

  <!-- where the map puts the robot (map -> base_link from TF, 20 Hz), TUM format - as every drive -->
  <node name="traj_rec_slam" pkg="sidewalk_slam" type="trajectory_recorder.py"
        args="--stack rtabmap --run-id $(arg run_id) --source tf
              --fixed-frame map --body-frame base_link --rate 20"
        output="screen"/>

  <!-- the same 1 Hz monitor as a drive (closure counts from /rtabmap/info) -->
  <node name="run_monitor" pkg="sidewalk_slam" type="run_monitor.py" output="screen">
    <param name="log_file" value="$(arg rtabmap_log)"/>
    <param name="out_file" value="$(env HOME)/.run_records/$(arg run_id)/monitor.csv"/>
    <param name="rate"     value="1.0"/>
  </node>
</launch>
